<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- حاوية عشان نحط الصورة وعليها زرار الرجوع -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- صورة الوجبة -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:scaleType="centerCrop"
                android:background="#FFCCBC"/>

            <!-- زرار الرجوع (بيظهر فوق الصورة) -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="#80000000"
                android:padding="10dp"
                android:tint="#FFFFFF"
                android:layout_margin="16dp"/>
            <!-- background="#80000000": لون أسود شفاف عشان الزرار يبان -->
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Italian Pizza"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#B71C1C"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 Mins • Easy"
                android:textColor="#757575"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredients"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="- 2 Cups Flour\n- 1 Cup Tomato Sauce\n- 200g Mozzarella\n- Fresh Basil"
                android:lineSpacingExtra="8dp"
                android:textSize="16sp"
                android:layout_marginBottom="20dp"/>

            <Button
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Add to Favorites"
                android:backgroundTint="#B71C1C"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>